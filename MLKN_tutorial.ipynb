import pandas as pd
import networkx as nx

# Charger le CSV
df = pd.read_csv("MLKN_Hierarchy_Master_File_Clean.csv")

# Créer un graphe NetworkX
G = nx.Graph()
for _, row in df.iterrows():
    G.add_node(row['id'], name=row['name'], layer=row['layer'])
    if pd.notna(row['parent_id']):
        G.add_edge(row['id'], row['parent_id'])

# Calculer la centralité de degré
degree_centrality = nx.degree_centrality(G)
print("Top 5 nodes by degree centrality:", sorted(degree_centrality.items(), key=lambda x: x[1], reverse=True)[:5])
